{
  "name": "tacticalpad",
  "version": "1.0.0",
  "description": "TacticalPad - Interactive soccer/football tactical board",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0"
  },
  "build": {
    "appId": "com.tacticalpad.app",
    "productName": "TacticalPad",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "src/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
